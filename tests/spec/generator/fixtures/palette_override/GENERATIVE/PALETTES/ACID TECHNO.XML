<?xml version="1.0" encoding="UTF-8"?>
<!-- An Acid techno palette override (spec §10.1), for the harness and the delugemu override run. Unzip the folder
     holding GENERATIVE/ onto a card root, with SAMPLES/DRUMS/MyKicks holding a kick or two. -->
<palette>
	<part name="ACID">
		<!-- Brightness reaches twice its default range on this preset, and Drive doesn't move it (spec §11.1). -->
		<preset path="SYNTHS/047 Basic Dirty Bass.XML" weight="2" brightness="200" drive="0"/>
	</part>
	<lane name="kick">
		<!-- A name FatFs rejects lists nothing; it mustn't stop the build. -->
		<folder path="SAMPLES/DRUMS/Bad*Folder"/>
		<folder path="SAMPLES/DRUMS/MyKicks"/>
	</lane>
	<lane name="rim">
		<file path="SAMPLES/DRUMS/Rim/808 Rim.wav"/>
	</lane>
	<lane name="cowbellSolo">
		<tag text="Cowbell"/>
	</lane>
	<laterIdea weight="3"/>
</palette>
