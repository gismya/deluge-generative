<?xml version="1.0" encoding="UTF-8"?>
<!-- A Melodic techno palette override (spec §10.1), for perform_sounds_override.txt's genre change: its BASS is one
     preset no Techno palette lists, so a pick of it comes from this file. -->
<palette>
	<part name="BASS">
		<!-- Thin reaches half its default range on this preset, and Space doesn't move it (spec §11.1). -->
		<preset path="SYNTHS/001 Sync Bass.XML" thin="50" space="0"/>
	</part>
</palette>
